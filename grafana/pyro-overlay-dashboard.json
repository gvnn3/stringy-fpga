{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus scraping the demo app's --serve /metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "PYRO A5 overlay engine on Alveo U250 — the four owner metrics (switch time, rules matched, packets dropped, rules missed) plus table identity and scan throughput. Mirrors web/pyro_dashboard.html; metric names come from pyro/telemetry.py prometheus_text().",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Device",
      "description": "1 = R84 ID probe passed. Silence past a failed probe is overloaded (wedged card vs swapped-out data plane), so 0 only says 'not usable'.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        { "expr": "pyro_device_usable", "legendFormat": "usable", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "no card", "color": "red" }, "1": { "text": "up", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false } }
    },
    {
      "type": "stat",
      "title": "Switch time (last)",
      "description": "Wall-clocked load_table swap. Measured anchor: 12.3 ms for a 2564 B table.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "targets": [
        { "expr": "pyro_switch_last_ms", "legendFormat": "last swap", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 1000 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false } }
    },
    {
      "type": "stat",
      "title": "Nominations / s",
      "description": "Rules matched, as a rate over the pattern-match nomination counter.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "targets": [
        { "expr": "rate(pyro_nominations_total[1m])", "legendFormat": "nominations/s", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } },
        "overrides": []
      },
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false } }
    },
    {
      "type": "stat",
      "title": "Request loss",
      "description": "sent-but-unanswered / sent. The honest cross-check on drops: netdev counters zero on onic reload and EQDMA multi-queue loss (up to 13% at >=2 H2C queues) never sets tuser_err.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "targets": [
        { "expr": "pyro_request_loss_ratio", "legendFormat": "request loss", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.001 }, { "color": "red", "value": 0.01 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false } }
    },
    {
      "type": "stat",
      "title": "Bytes / cycle",
      "description": "PERF counters cover the most recent scan only; engine design point is ~8 cycles/byte at 250 MHz.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "targets": [
        { "expr": "pyro_perf_bytes_per_cycle", "legendFormat": "bytes/cycle", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 3, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } },
        "overrides": []
      },
      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false } }
    },
    {
      "type": "stat",
      "title": "Scan throughput",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "targets": [
        { "expr": "pyro_perf_throughput_mb_s", "legendFormat": "MB/s", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "MBs", "decimals": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } },
        "overrides": []
      },
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false } }
    },
    {
      "type": "timeseries",
      "title": "Switch time vs 13.6 s PR baseline (log)",
      "description": "Log scale makes the ~4 orders of magnitude between a run-time table swap and a JTAG partial-reconfig visible on one axis. Baseline series is pyro_switch_pr_baseline_s converted to ms.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "id": 7,
      "targets": [
        { "expr": "pyro_switch_last_ms", "legendFormat": "table swap (ms)", "refId": "A" },
        { "expr": "pyro_switch_pr_baseline_s * 1000", "legendFormat": "JTAG PR baseline (ms)", "refId": "B" },
        { "expr": "pyro_switch_wire_ms_est", "legendFormat": "wire estimate (ms)", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 5,
            "showPoints": "auto",
            "scaleDistribution": { "type": "log", "log": 10 }
          },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "JTAG PR baseline (ms)" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [ 4, 4 ] } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "type": "bargauge",
      "title": "Top 10 rules by nominations (gid:sid)",
      "description": "pattern_id in a MATCH_REPLY is a slot index in the resident group; the collector attributes it back to gid:sid via the group's slot table.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "id": 8,
      "targets": [
        { "expr": "topk(10, pyro_nominations_by_sid)", "legendFormat": "{{sid}}", "refId": "A", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "showUnfilled": true,
        "valueMode": "color"
      }
    },
    {
      "type": "timeseries",
      "title": "Packets dropped (netdev)",
      "description": "Per-interval increase of ens2 counters. Caveats carried from the collector: counters zero on onic reload; EQDMA multi-queue loss is invisible here (no tuser_err) — watch request loss too.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 13 },
      "id": 9,
      "targets": [
        { "expr": "increase(pyro_netdev_rx_dropped[5m])", "legendFormat": "rx_dropped", "refId": "A" },
        { "expr": "increase(pyro_netdev_rx_errors[5m])", "legendFormat": "rx_errors", "refId": "B" },
        { "expr": "increase(pyro_netdev_rx_missed_errors[5m])", "legendFormat": "rx_missed", "refId": "C" },
        { "expr": "increase(pyro_netdev_tx_dropped[5m])", "legendFormat": "tx_dropped", "refId": "D" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "bargauge",
      "title": "Rules missed — decomposition",
      "description": "Hard misses among resident rules are 0 by the SR3 invariant (verified, not measured). OVF truncations are countable (engine caps replies at 61 entries). Non-resident and lowering-dropped rules are the coverage gap, not misses in flight.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 13 },
      "id": 10,
      "targets": [
        { "expr": "pyro_missed_resident_hard", "legendFormat": "hard misses (SR3 invariant)", "refId": "A", "instant": true },
        { "expr": "pyro_missed_ovf_truncation_events", "legendFormat": "OVF truncations", "refId": "B", "instant": true },
        { "expr": "pyro_missed_nonresident_rules", "legendFormat": "non-resident rules", "refId": "C", "instant": true },
        { "expr": "pyro_missed_lowering_dropped", "legendFormat": "lowering-dropped", "refId": "D", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "hard misses (SR3 invariant)" },
            "properties": [
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }
            ]
          }
        ]
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "showUnfilled": true
      }
    },
    {
      "type": "stat",
      "title": "Coverage (resident / corpus rules)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 13 },
      "id": 11,
      "targets": [
        { "expr": "pyro_coverage_resident_rules", "legendFormat": "resident", "refId": "A" },
        { "expr": "pyro_corpus_total_rules", "legendFormat": "corpus total", "refId": "B" },
        { "expr": "pyro_coverage_resident_rules / pyro_corpus_total_rules", "legendFormat": "fraction resident", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null } ] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "fraction resident" },
            "properties": [ { "id": "unit", "value": "percentunit" }, { "id": "decimals", "value": 1 } ]
          }
        ]
      },
      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "value_and_name" }
    },
    {
      "type": "stat",
      "title": "Table identity",
      "description": "Epoch increments on commit; active/load/commit flags come from TABLE_STATUS_REPLY. Capacity is in DFA states (40960).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 12,
      "targets": [
        { "expr": "pyro_table_epoch", "legendFormat": "epoch", "refId": "A" },
        { "expr": "pyro_table_capacity_states", "legendFormat": "capacity (states)", "refId": "B" },
        { "expr": "pyro_table_bytes_received", "legendFormat": "bytes received", "refId": "C" },
        { "expr": "pyro_table_active_valid", "legendFormat": "active_valid", "refId": "D" },
        { "expr": "pyro_table_load_open", "legendFormat": "load_open", "refId": "E" },
        { "expr": "pyro_table_commit_err", "legendFormat": "commit_err", "refId": "F" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null } ] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "commit_err" },
            "properties": [
              { "id": "mappings", "value": [ { "type": "value", "options": { "0": { "text": "ok", "color": "green" }, "1": { "text": "ERR", "color": "red" } } } ] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "active_valid" },
            "properties": [
              { "id": "mappings", "value": [ { "type": "value", "options": { "0": { "text": "no", "color": "red" }, "1": { "text": "yes", "color": "green" } } } ] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "load_open" },
            "properties": [
              { "id": "mappings", "value": [ { "type": "value", "options": { "0": { "text": "closed" }, "1": { "text": "open", "color": "yellow" } } } ] }
            ]
          }
        ]
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "value_and_name" }
    },
    {
      "type": "timeseries",
      "title": "Scan throughput (MB/s)",
      "description": "Most-recent-scan PERF window, not a running average. Bytes/cycle rides the stat tile above — different scale, so it does not share this axis.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 13,
      "targets": [
        { "expr": "pyro_perf_throughput_mb_s", "legendFormat": "MB/s", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "MBs",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "type": "stat",
      "title": "Scheduler mode",
      "description": "Refusal probe: invalid SCHED_SET; ACK echoes live state.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 30 },
      "id": 14,
      "targets": [
        { "expr": "pyro_sched_mode", "legendFormat": "mode", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "p0_only", "color": "blue" },
                "1": { "text": "p1_only", "color": "orange" },
                "2": { "text": "round_robin", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "text", "value": null } ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [ "lastNotNull" ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Quantum",
      "description": "Frames per RR turn, from the live SCHED_ACK echo.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 30 },
      "id": 15,
      "targets": [
        {
          "expr": "pyro_sched_quantum",
          "legendFormat": "quantum",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "text", "value": null } ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [ "lastNotNull" ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "MAC records lost",
      "description": "P1 report records dropped; healthy is exactly 0.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 30 },
      "id": 16,
      "targets": [
        {
          "expr": "pyro_mac_records_lost_total",
          "legendFormat": "records lost",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [ "lastNotNull" ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "P0 zero-slack residual",
      "description": "p0: seen - scanned - drops; healthy is exactly 0.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 30 },
      "id": 17,
      "targets": [
        {
          "expr": "pyro_sched_zero_slack_residual{program=\"p0\"}",
          "legendFormat": "p0 residual",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": { "0": { "text": "0", "color": "green" } }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "red", "value": null } ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [ "lastNotNull" ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "P1 zero-slack residual",
      "description": "p1: seen - digested - nonip - nokey; healthy 0.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 30 },
      "id": 18,
      "targets": [
        {
          "expr": "pyro_sched_zero_slack_residual{program=\"p1\"}",
          "legendFormat": "p1 residual",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": { "0": { "text": "0", "color": "green" } }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "red", "value": null } ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [ "lastNotNull" ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Wire grant rate by program",
      "description": "Each program counts the wire frames granted to it.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 34 },
      "id": 19,
      "targets": [
        {
          "expr": "rate(pyro_sched_seen_total{program=\"p0\"}[1m])",
          "legendFormat": "p0",
          "refId": "A"
        },
        {
          "expr": "rate(pyro_sched_seen_total{program=\"p1\"}[1m])",
          "legendFormat": "p1",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "fps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "green", "value": null } ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p0" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "blue" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p1" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "orange" }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
